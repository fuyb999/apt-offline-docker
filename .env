COMPOSE_PROJECT_NAME=apt-offline-gui

# Use the exact immutable core image consumed by docker-kde-plasma.
CORE_IMAGE=fuyb/docker-aura-desktop:v2026.7.26-22.04
BUILDER_TAG=jammy-native-pinyin

PINYIN_SOURCE_PACKAGE=fcitx5-pinyin
CC_SWITCH_VERSION=3.14.1
CC_SWITCH_DEB_URL=https://github.com/farion1231/cc-switch/releases/download/v3.14.1/CC-Switch-v3.14.1-Linux-x86_64.deb

NODE_VERSION=24.17.0
NVM_VERSION=0.40.4
NODE_DEFAULT_ENV=tools
BUN_VERSION=1.3.14
PNPM_VERSION=10.33.0
OPENCODE_VERSION=1.17.20
CODEX_VERSION=0.144.4
NVM_ARCHIVE_URL=https://github.com/nvm-sh/nvm/archive/refs/tags/v0.40.4.tar.gz
NODE_ARCHIVE_URL=https://nodejs.org/dist/v24.17.0/node-v24.17.0-linux-x64.tar.xz
BUN_ARCHIVE_URL=https://github.com/oven-sh/bun/releases/download/bun-v1.3.14/bun-linux-x64.zip
NVM_ARCHIVE_SHA256=5949b50e4640f2be2263f963952673d7f1a8745a83f05365e99f032fe78307fd
NODE_ARCHIVE_SHA256=ab343a1b747c7cbf3630dfd7dbf818c5423fab2eb4f5ad1afc896f6bd121a917
BUN_ARCHIVE_SHA256=951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f

# google-chrome-stable nvidia-container-toolkit docker-ce
# linux-headers-6.2.0-26-generic linux-image-6.2.0-26-generic linux-modules-6.2.0-26-generic linux-modules-extra-6.2.0-26-generic
#PKG_DOWNLOAD_LIST=dpkg-dev mokutil efibootmgr tpm2-tools sox whois bash git curl wget jq tree upx-ucl tar bzip2 zip unzip xz-utils rar unrar p7zip-full vim libpam-cracklib openssh-server net-tools build-essential g++ gcc gcc-12 make cmake libglvnd-dev pkg-config language-pack-zh-hans language-pack-zh-hans-base nvidia-container-toolkit docker-ce network-manager openresolv telnet openssl socat libseccomp-dev ipvsadm bind9 bind9utils bind9-doc dnsutils bash-completion rsync socat psmisc nfs-common lvm2 libseccomp2 ipvsadm ipset conntrack ansible

# The custom CC Switch package is supplied separately to apt-get. This list
# contains development tools, the desktop/native-pinyin stack and compatibility
# dependencies for local addons such as Chrome, TurboVNC, WPS and GTK apps.
PKG_DOWNLOAD_LIST=ansible bubblewrap build-essential diffutils fd-find findutils make openssl patch procps python3 python3-pip python3-venv ripgrep libayatana-appindicator3-1 libwebkit2gtk-4.1-0 libgtk-3-0 openbox lxqt-panel lxqt-theme-debian lxqt-archiver pcmanfm-qt qterminal breeze-icon-theme papirus-icon-theme dbus dbus-x11 dbus-user-session gvfs gvfs-daemons xauth x11-utils x11-xkb-utils xkb-data xdg-user-dirs fcitx5 fcitx5-config-qt fcitx5-frontend-qt5 fcitx5-module-xorg fcitx5-chinese-addons-data fcitx5-module-punctuation libboost-iostreams1.74.0 libimecore0 libimepinyin0 at-spi2-core avahi-utils iptables fcitx5-frontend-gtk2 fcitx5-frontend-gtk3 fcitx5-frontend-gtk4 fonts-dejavu fonts-firacode fonts-liberation fonts-noto-cjk fonts-noto-color-emoji fonts-wqy-microhei i965-va-driver-shaders intel-media-va-driver-non-free libcups2 libnspr4 libnss3 libpulse-mainloop-glib0 libxfont2 libpixman-1-0 libturbojpeg libxcb-image0 libxcb-render-util0 pipewire rtkit xdg-desktop-portal xdg-desktop-portal-gtk xdg-utils xserver-xorg-video-intel
