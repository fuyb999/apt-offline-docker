COMPOSE_PROJECT_NAME=apt-offline-gui

# Use the exact immutable core image consumed by docker-kde-plasma.
CORE_IMAGE=fuyb/docker-aura-desktop:v2026.6.24-22.04
BUILDER_TAG=jammy-native-pinyin

PINYIN_SOURCE_PACKAGE=fcitx5-pinyin
CC_SWITCH_VERSION=3.14.1
CC_SWITCH_DEB_URL=https://github.com/farion1231/cc-switch/releases/download/v3.14.1/CC-Switch-v3.14.1-Linux-x86_64.deb

NODE_VERSION=24.17.0
NVM_VERSION=0.40.4
NODE_DEFAULT_ENV=tools
PNPM_VERSION=10.33.0
OPENCODE_VERSION=1.17.20
CODEX_VERSION=0.144.4
CLAUDE_CODE_VERSION=2.1.153
CLAUDE_CODE_ROUTER_VERSION=3.0.4
NVM_ARCHIVE_URL=https://github.com/nvm-sh/nvm/archive/refs/tags/v0.40.4.tar.gz
NODE_ARCHIVE_URL=https://nodejs.org/dist/v24.17.0/node-v24.17.0-linux-x64.tar.xz

# The custom CC Switch package is supplied separately to apt-get. This list
# contains development tools, the desktop/native-pinyin stack and compatibility
# dependencies for local addons such as Chrome, TurboVNC, WPS and GTK apps.
PKG_DOWNLOAD_LIST=ansible bubblewrap build-essential diffutils fd-find findutils make openssl patch procps python3 python3-pip python3-venv ripgrep libayatana-appindicator3-1 libwebkit2gtk-4.1-0 libgtk-3-0 openbox lxqt-panel pcmanfm-qt breeze-icon-theme dbus-x11 dbus-user-session xauth x11-utils x11-xkb-utils xkb-data xdg-user-dirs fcitx5 fcitx5-config-qt fcitx5-frontend-qt5 fcitx5-module-xorg fcitx5-chinese-addons-data fcitx5-module-punctuation libboost-iostreams1.74.0 libimecore0 libimepinyin0 at-spi2-core avahi-utils iptables fcitx5-frontend-gtk2 fcitx5-frontend-gtk3 fcitx5-frontend-gtk4 fonts-dejavu fonts-firacode fonts-liberation fonts-noto-cjk fonts-noto-color-emoji fonts-wqy-microhei i965-va-driver-shaders intel-media-va-driver-non-free libnspr4 libnss3 libpulse-mainloop-glib0 libxfont2 libpixman-1-0 libxcb-image0 libxcb-render-util0 pipewire rtkit xdg-desktop-portal xdg-desktop-portal-gtk xdg-utils xserver-xorg-video-intel
